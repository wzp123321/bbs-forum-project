# =============================================================
#  环境变量样例 (复制为 .env 后按需修改)
# =============================================================

# 应用
APP_NAME=bbs-admin
SERVER_PORT=9999

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=bbs
MYSQL_PORT=3306
DB_URL=jdbc:mysql://mysql:3306/bbs?useSSL=false&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=change-me

# 前端
WEB_PORT=80
# 前端监控上报地址；留空则不启用
VITE_MONITOR_ENDPOINT=

# JWT 密钥，至少 32 字节；生产请用 openssl rand -base64 32 生成
BBS_JWT_SECRET=please-change-me-in-prod-32bytes-min
BBS_JWT_EXPIRE_MILLIS=604800000

# 管理员 userId（逗号分隔）
BBS_ADMIN_USER_IDS=b367c1d27d384bfeb435fb2e8e20072d

# 上传目录
BBS_UPLOAD_DIR=/app/upload

# 接口文档与 Druid 控制台
KNIFE4J_ENABLED=true
KNIFE4J_PRODUCTION=false
KNIFE4J_USERNAME=admin
KNIFE4J_PASSWORD=change-me
DRUID_USERNAME=druid
DRUID_PASSWORD=change-me

# 可观测性
ACTUATOR_EXPOSURE=health,info,metrics,prometheus
ACTUATOR_HEALTH_DETAILS=when-authorized

# 缓存：caffeine（默认）或 redis
CACHE_TYPE=caffeine
CACHE_TTL_SECONDS=600
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 搜索：sql（默认）或 elasticsearch
SEARCH_ENGINE=sql
ES_URL=http://elasticsearch:9200
ES_INDEX=bbs-post
ES_PORT=9200
